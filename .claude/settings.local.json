{
  "permissions": {
    "defaultMode": "auto"
  },
  "enabledMcpjsonServers": [
    "insforge",
    "sqlite",
    "waifu-rt3d-api"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-commit-check.sh",
            "if": "Bash(git commit*)",
            "timeout": 120,
            "statusMessage": "Running pre-commit checks (pytest + tsc)..."
          }
        ]
      }
    ]
  },
  "outputStyle": "Explanatory"
}
