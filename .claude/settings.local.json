{
  "permissions": {
    "deny": [
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/credentials*)",
      "Edit(**/app.db)",
      "Edit(**/*.db)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/credentials*)",
      "Write(**/app.db)",
      "Write(**/*.db)"
    ],
    "defaultMode": "auto"
  },
  "enabledMcpjsonServers": [],
  "disabledMcpjsonServers": [
    "insforge",
    "sqlite",
    "waifu-rt3d-api"
  ],
  "spinnerTipsEnabled": false,
  "autoDreamEnabled": true
}
