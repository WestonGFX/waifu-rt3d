# Waifu-RT3D Environment Variables
# Copy this file to .env and adjust values as needed.

# Structured JSON logging (one JSON object per log line)
# WAIFU_LOG_JSON=1

# Override the default frontend (default: "neon")
# WAIFU_DEFAULT_FRONTEND=neon

# Disable ChromaDB vector store initialization (useful for CI or minimal setups)
# WAIFU_DISABLE_VECTOR_STORE=1

# Enable dev mode (additional debug endpoints, hot-reload hints)
# WAIFU_DEV=1

# LLM endpoint (default: http://localhost:1234/v1 for LM Studio)
# WAIFU_LLM_ENDPOINT=http://localhost:1234/v1

# ComfyUI endpoint for image/video generation (default: http://localhost:8188)
# WAIFU_COMFYUI_ENDPOINT=http://localhost:8188
