# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
!frontends/sakura/dist/
!frontends/nova/dist/
build/
venv/
.venv/
env/
.env
.env.local

# ── Artifacts (generated by ./run.sh check) ─────────────────────────────────
artifacts/

# ── Logs & Debug Output ──────────────────────────────────────────────────────
*.log
debug.log
server_log*.txt
server_output*.txt
startup_error.log
backend/logs/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# ── Database (keep schema files, ignore live data) ───────────────────────────
backend/storage/app.db
backend/storage/app.db-shm
backend/storage/app.db-wal
waifu.db

# ── Vector Store / ChromaDB (runtime data, not source) ──────────────────────
backend/storage/memory/

# ── Serena MCP workspace ──────────────────────────────────────────────────────
.serena/

# ── Generated Audio Cache ────────────────────────────────────────────────────
backend/storage/audio/

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
.npm/
*.tgz

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.cursor/

# ── Test Artifacts & Debug Images ────────────────────────────────────────────
vrm-*-test.png
vrm-*-fix-test.png
*.tmp

# ── Session Transcripts (generated by Claude Code) ───────────────────────────
2026-*.txt
2025-*.txt

# ── Playwright / Browser Automation ──────────────────────────────────────────
.playwright-mcp/
playwright-report/
test-results/

# ── ML Models (large binary files — tracked separately or via Git LFS) ───────
backend/storage/models/

# ── TTS Voice Models (downloaded on-demand via Model Manager) ────────────────
backend/storage/tts_models/

# ── Telemetry Snapshots (large generated data, not source) ───────────────────
docs/telemetry/*.csv
docs/telemetry/*.txt
docs/telemetry/V2_HYBRID_7DAY_REPORT.md

# ── Experimental / WIP frontends (not tracked) ──────────────────────────────
frontends/dashboard/

# ── Archived cleanup staging area + full backup root (large zips, not source) ──
_BACKUP_ROOT/
.git.zip
.worktrees/
.superpowers/

# ── Database backups (runtime, not source) ──────────────────────────────────
backend/storage/_backups/

# ── User-uploaded images (runtime content) ──────────────────────────────────
backend/storage/images/

# ── TypeScript build info (generated cache) ─────────────────────────────────
*.tsbuildinfo

# ── Root package-lock (not a monorepo root — frontend locks live in frontends/) ──
/package-lock.json

# ── Unity (experimental, not actively tracked) ─────────────────────────────
unity/

# ── E2E screenshots (test artifacts) ────────────────────────────────────────
frontends/sakura/e2e/screenshots/

# ── Character doc archives (zips, not source) ───────────────────────────────
docs/characters/*.zip

# ── Visual Content MVP — AI-drafted character styles awaiting human review ──
backend/characters/builtin_image_styles.draft.json

# ── Other AI agent tool configs (project tracks Claude Code only) ───────────
.insforge
.agent
.agents
.augment
.cline
.codex/
.github/copilot*
.kilocode
.qoder
.qwen
.roo
.trae
.windsurf

# ── Claude Code: track agents/skills/rules/settings, ignore user-local cruft ──
.claude/.DS_Store
.claude/*.bak-*
.claude/**/*.bak-*
.claude/worktrees/
.claude/plans/

# ── Ephemeral Claude session docs (handoffs, transcripts, logs) ─────────────
docs/SESSION_*.md
!docs/SESSION_LOGGING_SETUP.md
docs/session-logs/
docs/CODEX_*.md
docs/CLAUDE_CODE_HANDOFF.md
docs/claude-code-handoff/
